# API authentication: JWT_SECRET is required and must contain at least 32 random characters.
# Keep the real value in the deployment secret store; never commit it here.

# Prevention priority score defaults (required by prevention-worker)
PREVENTION_SCORE_WEIGHT_SEVERITY=35
PREVENTION_SCORE_WEIGHT_FREQUENCY=20
PREVENTION_SCORE_WEIGHT_COVERAGE=15
PREVENTION_SCORE_WEIGHT_RECENCY=10
PREVENTION_SCORE_WEIGHT_RECURRENCE=10
PREVENTION_SCORE_WEIGHT_TREND=5
PREVENTION_SCORE_WEIGHT_EMERGENCE=5
PREVENTION_SCORE_SEVERITY_LOW_FACTOR=0.2
PREVENTION_SCORE_SEVERITY_MEDIUM_FACTOR=0.6
PREVENTION_SCORE_SEVERITY_HIGH_FACTOR=1
PREVENTION_SCORE_FREQUENCY_TARGET=10
PREVENTION_SCORE_COVERAGE_TARGET=5
PREVENTION_SCORE_RECENCY_RECENT_DAYS=7
PREVENTION_SCORE_RECENCY_CURRENT_DAYS=30
PREVENTION_SCORE_RECENCY_OLDER_DAYS=90
PREVENTION_SCORE_RECENCY_CURRENT_FACTOR=0.75
PREVENTION_SCORE_RECENCY_OLDER_FACTOR=0.4
PREVENTION_SCORE_RECENCY_STALE_FACTOR=0.1
PREVENTION_SCORE_RECURRENCE_TARGET_DAYS=4
PREVENTION_SCORE_TREND_WINDOW_DAYS=30
PREVENTION_SCORE_EMERGENCE_DAYS=30
PREVENTION_SCORE_EMERGENCE_MIN_OCCURRENCES=2

# Prevention API (P7)
PREVENTION_REBUILD_COOLDOWN_SECONDS=3600
PREVENTION_BUDGET_CONTINGENCY_RATE_PERCENT=10.00

# Prevention scheduler (P6)
PREVENTION_SCHEDULER_ENABLED=true
PREVENTION_SCHEDULER_TIMEZONE=Europe/Paris
PREVENTION_SCHEDULER_ORG_BATCH_SIZE=25
PREVENTION_SCHEDULER_REPORT_BATCH_SIZE=200
PREVENTION_SCHEDULER_COMPLETED_RETENTION_SECONDS=604800
PREVENTION_SCHEDULER_FAILED_RETENTION_SECONDS=2592000
PREVENTION_SCHEDULER_DIFFERENTIAL_CRON="0 2 * * *"
PREVENTION_SCHEDULER_CONSOLIDATION_CRON="0 3 * * *"
PREVENTION_SCHEDULER_WEEKLY_AUDIT_CRON="0 4 * * 0"
PREVENTION_SCHEDULER_MONTHLY_AUDIT_CRON="0 5 * * 0"
PREVENTION_SCHEDULER_CLEANUP_CRON="0 6 * * *"
