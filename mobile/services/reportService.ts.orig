import { api } from './api';

export type ReportStatus = 'brouillon' | 'envoye' | 'valide' | 'rejete' | 'archive';

export function getSuggestedReportFilename(data: {
  reportType?: string;
  client?: string;
  city?: string;
  address?: string;
  project?: string;
  date?: string | Date;
}) {
  const slug = (value: unknown) => {
    if (value === null || value === undefined) return '';
    const text = String(value).trim();
    if (!text || ['null', 'undefined'].includes(text.toLowerCase())) return '';
    return text
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '_')
      .replace(/^_+|_+$/g, '');
  };

  const rawType = slug(data.reportType);
  const reportType = rawType.includes('reunion') ? 'reunion' : 'vc';

  const addressValue = String(data.city || data.address || '').trim();
  const addressParts = addressValue.split(',').map((part) => part.trim()).filter(Boolean);
  const citySource = addressParts[addressParts.length - 1] || addressValue;
  const city = slug(citySource.replace(/\b\d{5}\b/g, ' '));

  const rawDate = data.date;
  const dateParts: string[] = [];
  const isoMatch = typeof rawDate === 'string' && rawDate.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (isoMatch) {
    dateParts.push(isoMatch[3], isoMatch[2], isoMatch[1]);
  } else if (rawDate) {
    const parsedDate = new Date(rawDate);
    if (!Number.isNaN(parsedDate.getTime())) {
      dateParts.push(
        String(parsedDate.getDate()).padStart(2, '0'),
        String(parsedDate.getMonth() + 1).padStart(2, '0'),
        String(parsedDate.getFullYear()),
      );
    }
  }

  const parts = ['CR', reportType, slug(data.client), city, slug(data.project), ...dateParts];
  return `${parts.filter(Boolean).join('_')}.pdf`;
}

export interface Report {
  id: string;
  missionId: string;
  visitId?: string;
  userId: string;
  title: string;
  content: string;
  header?: string;
  footer?: string;
  status: ReportStatus;
  conformityPercentage: number;
  sentAt?: string;
  recipientEmail?: string;
  createdAt: string;
  updatedAt: string;
  mission?: any;
  visit?: any;
  reportFileUrl?: string;
}

export interface GeneratedReportPdf {
  url: string;
  key: string;
  size: number;
  fileName: string;
}

export interface CreateReportData {
  missionId: string;
  visitId?: string;
  title: string;
  content: string;
  header?: string;
  footer?: string;
  status?: ReportStatus;
  conformityPercentage?: number;
  recipientEmail?: string;
  reportFileUrl?: string;
}

export interface UpdateReportData {
  title?: string;
  content?: string;
  header?: string;
  footer?: string;
  status?: ReportStatus;
  conformityPercentage?: number;
  recipientEmail?: string;
  reportFileUrl?: string;
}

export const reportService = {
  async getReports(status?: ReportStatus) {
    const url = status ? `/reports?status=${status}` : '/reports';
    return api.get<Report[]>(url);
  },

  async getReport(id: string) {
    return api.get<Report>(`/reports/${id}`);
  },

  async createReport(data: CreateReportData) {
    return api.post<Report>('/reports', data);
  },

  async updateReport(id: string, data: UpdateReportData) {
    return api.put<Report>(`/reports/${id}`, data);
  },

  async deleteReport(id: string) {
    return api.delete(`/reports/${id}`);
  },

  async getReportCounts() {
    return api.get<{ [key: string]: number }>('/reports/counts');
  },

  async generateServerPdf(id: string, fileName: string, forceRegenerate = false) {
    return api.post<GeneratedReportPdf>(`/reports/${id}/pdf`, { fileName, forceRegenerate });
  },

  async generateServerPdfByVisit(visitId: string, fileName: string, forceRegenerate = false) {
    return api.post<GeneratedReportPdf>(`/reports/by-visit/${visitId}/pdf`, { fileName, forceRegenerate });
  },

  async sendReportEmail(id: string, email: string, subject: string, message: string) {
    return api.post(`/reports/${id}/send`, { email, subject, message });
  },

  async validateReport(id: string) {
    return api.put<Report>(`/reports/${id}`, { status: 'valide' as ReportStatus });
  },
};
