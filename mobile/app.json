{
  "expo": {
    "name": "Report BTP",
    "slug": "reportbtp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_admin_app.png",
    "scheme": "reportbtp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.csps.reportbtp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-camera",
      [
        "expo-media-library",
        {
          "photosPermission": "L'application a besoin d'accéder à vos photos pour sauvegarder les photos de visite.",
          "savePhotosPermission": "L'application a besoin de sauvegarder les photos de visite sur votre appareil.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application a besoin d'accéder à vos photos pour sélectionner des images de visite."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "networkSecurityConfig": "./network_security_config.xml"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-mail-composer"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5f999cfe-4eae-4ee7-8d23-940b93c6571d"
      }
    },
    "android": {
      "package": "com.csps.reportbtp",
      "permissions": [
        "CAMERA",
        "MEDIA_LIBRARY",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    }
  }
}